# Single source of truth for every version and name in the demo.
# Make-includable and shell-sourceable: KEY=value, no spaces, no expansions.

CLUSTER_NAME=sovereign-ci
KIND_NODE_IMAGE=kindest/node:v1.36.1

# One domain, resolved two ways — no /etc/hosts edit, no local DNS server:
#   host -> 127.0.0.1        (sslip.io encodes the IP in the name; kind publishes
#                             80/443 on the host via extraPortMappings)
#   pods -> node InternalIP  (CoreDNS `hosts` block for this zone, see scripts/dns.sh)
# The dash form keeps the name a single label: forgejo.127-0-0-1.sslip.io
# The per-service hostnames are derived in the Makefile and in scripts/lib.sh
# (this file must stay valid for both make and bash, so no expansions here).
DEMO_DOMAIN=127-0-0-1.sslip.io

# Pinned component versions (verified to exist).
TEKTON_PIPELINE_VERSION=v1.6.0
TEKTON_CHAINS_VERSION=v0.26.0
TEKTON_DASHBOARD_VERSION=v0.63.1
PAC_VERSION=v0.50.0

# Trusted Resources: the tkn CLI that signs Task/Pipeline resources must be built
# against the same API libraries as the controller, or the signature never
# verifies (the JSON it hashes differs: see scripts/trusted-resources.sh).
# For Tekton Pipelines v1.6.0 the newest aligned release is 0.41.0.
# Newer CLIs sign a different byte string; 0.43.0 and 0.46.0 both fail.
# The demo does NOT download it: install it yourself and export TKN_TRUSTED.
TKN_TRUSTED_VERSION=0.41.0

HAPROXY_INGRESS_CHART_VERSION=1.54.2
FORGEJO_CHART_VERSION=17.1.5
ZOT_CHART_VERSION=0.1.122

FORGEJO_ADMIN_USER=forgejo_admin
FORGEJO_ADMIN_PASSWORD=sovereign-demo-42
FORGEJO_ORG=acme

# Demo-only password for the bundle signing key (tkn/cosign read COSIGN_PASSWORD).
COSIGN_PASSWORD=demo-bundle-key

# The developer who pushes in the talk's recordings: the videos follow this account
# in the forge's web editor, not the admin.
FORGEJO_DEV_USER=dev
FORGEJO_DEV_PASSWORD=developer-demo-42
